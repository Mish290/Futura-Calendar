{
  "name": "futura-calendar",
  "version": "1.0.0",
  "description": "Futura - Calendar, applicazione desktop",
  "main": "main.js",
  "author": "Futura",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "resedit": "^3.1.1"
  },
  "build": {
    "appId": "com.futura.calendar",
    "productName": "Futura Calendar",
    "asar": true,
    "files": [
      "main.js",
      "app/**/*",
      "build/icon.ico"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Futura Calendar"
    },
    "afterPack": "./afterPack.js"
  }
}